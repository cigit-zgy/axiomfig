# Latin family names match the Homebrew Latin Modern font metadata.
font.family: LMSans10
mathtext.fontset: custom
mathtext.rm: Latin Modern Math
mathtext.it: Latin Modern Math
mathtext.bf: Latin Modern Math
mathtext.bfit: Latin Modern Math
mathtext.cal: Latin Modern Math
mathtext.sf: LMSans10
mathtext.tt: LMSans10
mathtext.fallback: None
