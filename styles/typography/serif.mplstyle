# One complete serif publication family. Maple Mono is restricted to code roles.
font.family: LMRoman10
font.serif: LMRoman10, Noto Serif CJK SC, Noto Serif CJK JP
font.monospace: Maple Mono
mathtext.fontset: custom
mathtext.rm: Latin Modern Math
mathtext.it: Latin Modern Math
mathtext.bf: Latin Modern Math
mathtext.bfit: Latin Modern Math
mathtext.cal: Latin Modern Math
mathtext.sf: Latin Modern Math
mathtext.tt: Maple Mono
mathtext.fallback: None
